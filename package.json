{
  "name": "healthome",
  "version": "1.7.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "build:android": "eas build -p android --profile production",
    "validate": "node scripts/validate-project.js",
    "build:apk": "eas build -p android --profile apk",
    "build:production": "eas build -p android --profile production",
    "backend:install": "cd backend && npm install",
    "backend:dev": "cd backend && npm run dev",
    "backend:db:generate": "cd backend && npm run db:generate",
    "backend:db:migrate": "cd backend && npm run db:migrate",
    "backend:seed": "cd backend && npm run db:seed"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.35",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "expo-status-bar": "~3.0.9",
    "expo-auth-session": "~7.0.0",
    "expo-web-browser": "~15.0.0"
  }
}